# Example environment variables for the React client
# Copy this file to .env.local or .env when developing and fill values as needed

# Base API URL used by the client. During development you can keep the default
# which is proxied to http://localhost:5000 by the package.json "proxy" field.
REACT_APP_API_BASE_URL=http://localhost:5000/api

# If you use Stripe on the client, set the publishable key here (test key)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here

# Any other REACT_APP_* env vars referenced in the client should be added here.